# Meteors. A and D to move, dodge the falling rocks.
# You have three lives. The score counts the rocks you outlast.

sprite ship [ 0x60 0xF0 0x90 ]
sprite rock [ 0xC0 0xC0 ]

var px = 30
var ax = 10
var ay = 0
var bx = 40
var by = 14
var score = 0
var lives = 3

def dropA {
  ay = 0
  rand ax, 0x3F
  score += 1
}

def dropB {
  by = 0
  rand bx, 0x3F
  score += 1
}

def gameover {
  clear
  show score at 28, 13
  halt
}

loop {
  clear

  if key(A) { px -= 1 }
  if key(D) { px += 1 }
  if px > 60 { px = 60 }
  if px < 1  { px = 1 }

  ay += 1
  by += 1
  if ay > 29 { dropA }
  if by > 29 { dropB }

  # The rocks go down first, then the ship on top, so one check of hit
  # asks only whether the ship ran into something.
  draw rock at ax, ay
  draw rock at bx, by
  draw ship at px, 28

  if hit {
    lives -= 1
    beep 6
    dropA
    dropB
    if lives == 0 { gameover }
  }

  show score at 1, 0
  wait
}
